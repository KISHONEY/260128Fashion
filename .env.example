# ------------------------------------------------------------
#  환경변수는 "선택 사항" 입니다.
#  기본 설정은 src/config.ts 파일에 Supabase 주소와 공개키만 넣으면 끝납니다.
#  아래 값은 추가 기능이 필요할 때만 Vercel(또는 Netlify)의 환경변수에 넣으세요.
# ------------------------------------------------------------

# (선택) src/config.ts 대신 환경변수로 접속 정보를 넣고 싶을 때
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# (선택) Secret key — 넣으면 다음 기능이 켜집니다. ※ 절대 코드에 넣지 마세요!
#   - 이메일로 초대 메일 보내기
#   - 멤버 제거 시 로그인 계정까지 완전히 삭제
#   - 멘션 이메일 알림 (아래 RESEND 값도 필요)
SUPABASE_SECRET_KEY=

# (선택) 사이트 주소 — 비워 두면 접속한 주소를 자동으로 사용
NEXT_PUBLIC_SITE_URL=

# (선택) 멘션 이메일 알림 — Resend(https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=
