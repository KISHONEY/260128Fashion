# ------------------------------------------------------------
#  환경변수 예시 파일
#  이 파일을 복사해서 ".env.local" 이라는 이름으로 저장한 뒤
#  오른쪽 값을 본인의 Supabase 값으로 바꿔 넣으세요.
#  (.env.local 은 비밀 정보이므로 GitHub 에 올라가지 않습니다)
# ------------------------------------------------------------

# Supabase → Project Settings → API (또는 Data API) → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key"
#   (예전 화면이라면 "anon public" 키를 넣어도 됩니다)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Supabase → Project Settings → API Keys → "Secret key"
#   (예전 화면이라면 "service_role" 키) ※ 절대 외부에 공개하지 마세요!
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# 사이트 주소 (로컬에서는 그대로, 배포 후에는 Vercel 주소로 변경)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (선택) 멘션 이메일 알림 — Resend(https://resend.com) 를 쓸 때만 입력
RESEND_API_KEY=
# 보내는 사람 주소 (Resend 에서 인증한 도메인 주소)
EMAIL_FROM=
